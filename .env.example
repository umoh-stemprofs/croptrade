# Required — hosted Neon Postgres (never commit the real .env)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Optional — if set, market prices come from this live endpoint (falls back to the simulated feed)
MARKET_API_URL=

# Optional — OpenWeatherMap key; when empty the app uses Open-Meteo (no key)
OWM_API_KEY=
