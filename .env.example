# Required — hosted Neon Postgres (never commit the real .env)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Optional — if set, market prices come from this live endpoint (falls back to the simulated feed)
MARKET_API_URL=

# Optional — OpenWeatherMap key; when empty the app uses Open-Meteo (no key)
OWM_API_KEY=

# Required — session cookie encryption (iron-session). Generate 32+ random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-64-random-hex-characters

# Optional — set to true to show the "Try demo account" button on the login page
DEMO_MODE=true
